
server {
	listen 80 default_server;
	listen [::]:80 default_server;

	# root /var/www/trade;

	# Add index.php to the list if you are using PHP
	index index.html index.htm index.nginx-debian.html;

	server_name _;

		# Reverse proxy for backend and WebSocket connections
    	location /backend {
        	# Strip the /backend prefix before passing to the Node/backend app
        	# Remove or adjust this line if your backend expects the /backend prefix
        	# rewrite ^/backend(.*)$ $1 break; # no need to strip prefix as we are using the same route

        	# Forward traffic to the localhost service
        	proxy_pass http://127.0.0.1:3001;

        	# Standard proxy headers
        	proxy_set_header Host $host;
        	proxy_set_header X-Real-IP $remote_addr;
        	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        	proxy_set_header X-Forwarded-Proto $scheme;

        	# WebSocket header updates (Hop-by-hop headers)
        	proxy_http_version 1.1;
        	proxy_set_header Upgrade $http_upgrade;
        	proxy_set_header Connection "upgrade";

        	# Max time / Timeout configurations for WebSockets
        	# Prevents NGINX from closing idle WebSocket connections prematurely (set to 7 days)
        	proxy_read_timeout 604800s;
        	proxy_send_timeout 604800s;
    	}

		# Reverse proxy for backend and WebSocket connections
    	location / {
        	# Forward traffic to the localhost service
        	proxy_pass http://127.0.0.1:4000;

        	# Standard proxy headers
        	proxy_set_header Host $host;
        	proxy_set_header X-Real-IP $remote_addr;
        	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        	proxy_set_header X-Forwarded-Proto $scheme;

        	# WebSocket header updates (Hop-by-hop headers)
        	proxy_http_version 1.1;
        	proxy_set_header Upgrade $http_upgrade;
        	proxy_set_header Connection "upgrade";

        	# Max time / Timeout configurations for WebSockets
        	# Prevents NGINX from closing idle WebSocket connections prematurely (set to 7 days)
        	proxy_read_timeout 604800s;
        	proxy_send_timeout 604800s;
    	}

    	


}


